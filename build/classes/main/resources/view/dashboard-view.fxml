<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane id="AnchorPane" prefHeight="629.0" prefWidth="727.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.vyorg.abarroteria.kinal.controller.DashboardController">
    <stylesheets>
        <URL value="@/main/resources/css/dashboard-view.css" />
    </stylesheets>
    <children>
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <center>
                <TableView fx:id="tableProducto" BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="tableColumnIdProducto" prefWidth="150.0" text="ID Producto" />
                        <TableColumn fx:id="tableColumnNombre" prefWidth="250.0" text="Nombre" />
                        <TableColumn fx:id="tableColumnStock" prefWidth="120.0" text="Stock" />
                        <TableColumn fx:id="tableColumnPrecio" prefWidth="120.0" text="Precio" />
                    </columns>
                </TableView>
            </center>
            <bottom>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#handleCerrarSesion" styleClass="btn-secundary" stylesheets="@/main/resources/css/button-style.css" text="Cerrar sesion" />
                        <Button fx:id="btnEliminarProducto" mnemonicParsing="false" onAction="#handleEliminarProducto" styleClass="btn-primary" stylesheets="@/main/resources/css/button-style.css" text="Eliminar producto" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</AnchorPane>
